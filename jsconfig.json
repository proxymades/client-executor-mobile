            ],
            "@hooks_query/*": [
                "./src/hooks/query/*"
            ],
            "@hooks_subscription/*": [
                "./src/hooks/subscription/*"
            ],
            "@hooks_actions/*": [
                "./src/hooks/actions/*"
            ],
            "@gql_mutation/*": [
                "./src/gql/mutation/*"
            ],
            "@gql_query/*": [
                "./src/gql/query/*"
            ],
            "@gql_actions/*": [
                "./src/gql/actions/*"
